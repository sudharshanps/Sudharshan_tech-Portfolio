# SUDHARSHAN_TECH — production environment template
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=https://sudharshantech.com
ADDITIONAL_ALLOWED_ORIGINS=https://www.sudharshantech.com
MONITORING_INTERVAL_MS=60000

# Admin API authentication: generate a long random secret; never use a placeholder.
ADMIN_SECRET=replace_with_a_random_64_character_secret

# Supabase project settings (server-side ONLY; never expose the service-role key to Vite).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Notification recipient — SUDHARSHAN_TECH owner.
TO_EMAIL=sudharshantech123@gmail.com
WHATSAPP_RECIPIENT=919791495418

# Email notifications via Resend. Verify the sender domain before production use.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=SUDHARSHAN_TECH <notifications@your-verified-domain.com>

# WhatsApp Cloud API (Meta). Use an approved utility template with seven body variables.
WHATSAPP_ACCESS_TOKEN=YOUR_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_TEMPLATE_NAME=new_website_enquiry
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Leave blank for same-origin API requests when frontend and backend share the Render service.
VITE_API_BASE_URL=
