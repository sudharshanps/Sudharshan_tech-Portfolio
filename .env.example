# SUDHARSHAN_TECH — Environment Configuration Template
# Copy this file to .env and provide your production variables.

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=https://sudharshantech.com

# Critical: Generate a secure 64-character random token for production administration
# Example command to generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# If left as default in production, an ephemeral random secret is automatically generated on startup
ADMIN_SECRET=generate_and_insert_secure_64_character_hex_secret_here

# Additional CORS allowed origins (optional comma-separated list)
ADDITIONAL_ALLOWED_ORIGINS=https://www.sudharshantech.com

# Optional: Persistent data mount directory (for cloud volumes like Railway / Render /data disk)
# DATA_DIR=/data

MONITORING_INTERVAL_MS=60000

# Client Configuration (Vite Frontend)
# Leave empty for same-origin / relative proxy (/api), or specify your deployed backend URL:
# VITE_API_BASE_URL=https://sudharshantech.com
VITE_API_BASE_URL=

# Primary Notification Recipient
TO_EMAIL=sudharshanthemagnet@gmail.com
COMPANY_PHONE=+919791495418

# SMTP Email Provider (Optional: for live SMTP automated mail dispatch)
# Examples: SendGrid, Resend, AWS SES, or Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sudharshanthemagnet@gmail.com
SMTP_PASS=your-google-app-password-here
